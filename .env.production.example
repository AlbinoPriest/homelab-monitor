# Copy to .env for production and replace both passwords before first start.
POSTGRES_DB=homelab_monitor
POSTGRES_ADMIN_USER=homelab_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
APP_DB_USER=homelab_app
APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

# Bind to loopback behind a TLS-terminating reverse proxy on the host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SESSION_TIMEOUT=30m

RAW_CHECK_RETENTION_ENABLED=true
RAW_CHECK_RETENTION_DAYS=30
RAW_CHECK_RETENTION_BATCH_SIZE=1000
RAW_CHECK_RETENTION_MAX_BATCHES_PER_RUN=10
RAW_CHECK_RETENTION_INITIAL_DELAY=60000
RAW_CHECK_RETENTION_CLEANUP_DELAY=86400000

SSE_MAX_CONNECTIONS=8
SSE_CONNECTION_TIMEOUT=300000
SSE_HEARTBEAT_DELAY=15000
