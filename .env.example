# Local development defaults only. Replace every credential for production.
POSTGRES_DB=homelab_monitor
POSTGRES_USER=homelab_monitor
POSTGRES_PASSWORD=homelab_monitor_dev
POSTGRES_PORT=5432
RAW_CHECK_RETENTION_ENABLED=true
RAW_CHECK_RETENTION_DAYS=30
RAW_CHECK_RETENTION_BATCH_SIZE=1000
RAW_CHECK_RETENTION_MAX_BATCHES_PER_RUN=10
RAW_CHECK_RETENTION_INITIAL_DELAY=60000
RAW_CHECK_RETENTION_CLEANUP_DELAY=86400000
SSE_MAX_CONNECTIONS=8
SSE_CONNECTION_TIMEOUT=300000
SSE_HEARTBEAT_DELAY=15000
